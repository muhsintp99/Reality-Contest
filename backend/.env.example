# Server Port & Environment
PORT=10000
NODE_ENV=development

# Database Connections
MONGODB_URI=mongodb://127.0.0.1:27017/reality_contest
REDIS_URL=redis://127.0.0.1:6379

# Authentication & JWT Secrets
JWT_ACCESS_SECRET=change_this_to_a_secure_random_string
JWT_REFRESH_SECRET=change_this_to_a_secure_random_string
ACCESS_TOKEN_EXPIRY=2d
REFRESH_TOKEN_EXPIRY=7d

# Cloud File Storage (Optional - AWS S3 / Cloudinary)
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=us-east-1
# AWS_S3_BUCKET=
# CLOUDINARY_URL=

# Nodemailer SMTP Email Config (for Email OTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM=Reality Contest Platform <noreply@realitycontest.com>

# Firebase Admin SDK Credentials
FIREBASE_PROJECT_ID=reality-contest-platform
FIREBASE_CLIENT_EMAIL=your-firebase-service-account@project.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
